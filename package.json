{
  "name": "multifamily-opportunity-radar",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Private Florida multifamily investment research and underwriting workspace.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run test:finance && npm run test:guards && npm run test:auth && npm run test:workspace && npm run test:research",
    "test:auth": "node --test --test-reporter=spec tests/auth/*.test.ts",
    "test:workspace": "node --test --test-reporter=spec tests/workspace/*.test.ts",
    "test:integration": "node --test --test-reporter=spec tests/integration/*.test.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:database": "node scripts/db-test.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-check": "node scripts/db-restore-check.mjs",
    "test:finance": "node --test --test-reporter=spec tests/finance/*.test.ts",
    "test:guards": "node scripts/test-financial-guards.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "test:research": "node --test --test-reporter=spec tests/research/*.test.ts",
    "test:research:database": "node scripts/research-db-test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.1.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/simplify": "7.4.0",
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "better-auth": "1.7.4",
    "lucide-react": "1.45.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "railway": "3.11.0",
    "typescript": "5.9.3"
  }
}
