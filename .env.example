# Template only. Copy to private .env.local and supply this workspace's values.
# Keep secrets out of Git, logs, screenshots and NEXT_PUBLIC_ variables.
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Exact application origin, no path. HTTP is permitted only on loopback.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a private random secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Email sign-in: one or two comma-separated approved addresses.
ALLOWED_EMAILS=
# Temporarily enable only for initial password creation; close after setup.
ACCOUNT_SETUP_OPEN=false

# Optional GitHub sign-in: configure both credentials and approved numeric IDs.
# Leaving both credentials empty disables GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_IDS=110749578

# Explicit intended database; PostgreSQL 16 or newer.
DATABASE_URL=
# verify-full for Internet connections. disable allowed only on loopback or
# Railway's private *.railway.internal network (no public database proxy).
DATABASE_SSL_MODE=verify-full
# Optional private CA certificate for verified server connections.
DATABASE_SSL_CA=
